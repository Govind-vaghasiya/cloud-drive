# ==============================================================================
# Cloud Drive Environment Configuration
# ==============================================================================

# Server Domain & Port
PORT=5000
NODE_ENV=development
APP_DOMAIN=drive2.govindvaghasiya.ca
BASE_URL=https://drive2.govindvaghasiya.ca

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cloud_drive
DB_USER=cloud_drive_user
DB_PASSWORD=change_this_secure_password_in_production
DATABASE_URL=postgresql://cloud_drive_user:change_this_secure_password_in_production@postgres:5432/cloud_drive

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Authentication (better-auth)
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here_for_auth
BETTER_AUTH_URL=https://drive2.govindvaghasiya.ca

# File Storage & Master Key (Per-file AES-256-GCM wrapping)
STORAGE_DIR=/app/data/storage
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OnlyOffice Integration (Phase 7)
ONLYOFFICE_URL=http://onlyoffice
ONLYOFFICE_JWT_SECRET=change_this_onlyoffice_secret_in_production

# Cloudflare Tunnel Token (optional if running cloudflared via Docker Compose)
# CLOUDFLARE_TUNNEL_TOKEN=
